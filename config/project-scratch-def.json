{
    "orgName": "Playground Scratch Org",
    "edition": "Developer",
    "language": "en_US",
    "country": "US",
    "features": ["Communities", "Knowledge", "RecordTypes", "EnableSetPasswordInApi"],
    "description": "Scratch org for Playground project for validation and testing on CI/CD Pipeline.",
    "settings": {
        "lightningExperienceSettings": {
            "enableS1DesktopEnabled": true
        },
        "communitiesSettings": {
            "enableNetworksEnabled": true
        },
        "experienceBundleSettings": {
            "enableExperienceBundleMetadata": true
        },
        "caseSettings": {
            "emailToCase": {
                "enableEmailToCase": true
            },
            "webToCase": {
                "enableWebToCase": true
            }
        },
        "knowledgeSettings": {
            "enableKnowledge": true,
            "enableLightningKnowledge": true
        }
    }
}
